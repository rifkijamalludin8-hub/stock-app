<%- include('../partials/head', { pageTitle: type === 'IN' ? 'Transaksi Masuk' : 'Transaksi Keluar', page: type === 'IN' ? 'in' : 'out' }) %>

<div class="grid-2">
  <div class="card">
    <div class="card-header">
      <div>
        <h3><%= editTx ? 'Edit Transaksi' : 'Tambah Transaksi' %> <%= type %></h3>
        <p>Input pergerakan stock.</p>
      </div>
    </div>
    <% if (editTx) { %>
      <form method="post" action="/transactions/<%= editTx.id %>/update" class="form-grid">
        <input type="hidden" name="type" value="<%= type %>" />
        <label>
          Tanggal
          <input name="txn_date" type="date" value="<%= formatDate(editTx.txn_date) %>" required />
        </label>
        <label>
          Cari Item
          <input type="text" class="select-search" data-target="txn-item-select" placeholder="Ketik nama item..." />
        </label>
        <label>
          Item
          <select id="txn-item-select" name="item_id" required>
            <option value="">Pilih Item</option>
            <% items.forEach((item) => { %>
              <option value="<%= item.id %>" <%= String(item.id) === String(editTx.item_id) ? 'selected' : '' %>>
                <%= item.group_name %> - <%= item.name %> - <%= formatDate(item.expiry_date) %>
              </option>
            <% }) %>
          </select>
        </label>
        <label>
          Qty
          <input name="qty" type="number" step="0.01" value="<%= editTx.qty %>" required />
        </label>
        <% if (showPrice && type === 'IN') { %>
          <label>
            Harga/Unit
            <input name="price_per_unit" type="text" inputmode="decimal" value="<%= editTx.price_per_unit || '' %>" />
          </label>
        <% } %>
        <label class="full">
          Catatan
          <textarea name="note" rows="2"><%= editTx.note || '' %></textarea>
        </label>
        <div class="actions">
          <button class="btn primary" type="submit">Simpan Perubahan</button>
          <a class="btn ghost" href="/transactions?type=<%= type %>">Batal</a>
        </div>
      </form>
    <% } else { %>
      <form method="post" action="/transactions" class="form-grid">
        <input type="hidden" name="type" value="<%= type %>" />
        <label>
          Tanggal
          <input name="txn_date" type="date" value="<%= today %>" />
        </label>
        <label>
          Cari Item
          <input type="text" class="select-search" data-target="txn-item-select" placeholder="Ketik nama item..." />
        </label>
        <label>
          Item
          <select id="txn-item-select" name="item_id" required>
            <option value="">Pilih Item</option>
            <% items.forEach((item) => { %>
              <option value="<%= item.id %>"><%= item.group_name %> - <%= item.name %> - <%= formatDate(item.expiry_date) %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Qty
          <input name="qty" type="number" step="0.01" required />
        </label>
        <% if (showPrice && type === 'IN') { %>
          <label>
            Harga/Unit
            <input name="price_per_unit" type="text" inputmode="decimal" placeholder="Contoh: 10.000,50" />
          </label>
        <% } %>
        <label class="full">
          Catatan
          <textarea name="note" rows="2"></textarea>
        </label>
        <button class="btn primary" type="submit">Simpan</button>
      </form>
    <% } %>
    <div class="export-row">
      <a class="btn ghost" href="/export/transactions?format=xlsx">Export Excel</a>
      <a class="btn ghost" href="/export/transactions?format=pdf">Export PDF</a>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div>
        <h3>Riwayat Transaksi <%= type %></h3>
        <p>Menampilkan 50 transaksi terakhir.</p>
      </div>
      <div class="segmented">
        <a class="btn <%= type === 'IN' ? 'primary' : 'ghost' %>" href="/transactions?type=IN">Masuk</a>
        <a class="btn <%= type === 'OUT' ? 'primary' : 'ghost' %>" href="/transactions?type=OUT">Keluar</a>
      </div>
    </div>
    <% if (user && user.role === 'user') { %>
      <div class="bulk-actions">
        <form id="bulk-delete-form" class="bulk-form" method="post" action="/transactions/delete-selected" data-bulk-form="transactions">
          <input type="hidden" name="type" value="<%= type %>" />
          <button class="btn danger" type="submit" data-bulk-delete disabled>Hapus Terpilih</button>
          <span class="muted">Pilih transaksi lalu klik hapus.</span>
        </form>
        <form class="bulk-form" method="post" action="/transactions/delete-all" onsubmit="return confirm('Hapus semua transaksi <%= type %>?')">
          <input type="hidden" name="type" value="<%= type %>" />
          <input type="hidden" name="confirm_text" value="HAPUS SEMUA TRANSAKSI" />
          <button class="btn danger ghost" type="submit">Hapus Semua</button>
        </form>
      </div>
    <% } %>
    <div class="scroll-box">
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <% if (user && user.role === 'user') { %>
                <th><input type="checkbox" data-select-all /></th>
              <% } %>
              <th>Tanggal</th>
              <th>Item</th>
              <th>Qty</th>
              <% if (showPrice && type === 'IN') { %><th>Harga/Unit</th><% } %>
              <th>Catatan</th>
              <th>Dibuat Oleh</th>
              <th>Dibuat</th>
              <% if (user && user.role === 'user') { %><th>Aksi</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% transactions.forEach((t) => { %>
              <tr>
                <% if (user && user.role === 'user') { %>
                  <td>
                    <input type="checkbox" name="ids" value="<%= t.id %>" form="bulk-delete-form" data-row-select />
                  </td>
                <% } %>
                <td><%= formatDateTime(t.txn_date) %></td>
                <td><%= t.item_label %></td>
                <td><%= formatQty(t.qty) %></td>
                <% if (showPrice && type === 'IN') { %><td><%= formatPrice(t.price_per_unit) %></td><% } %>
                <td><%= t.note || '-' %></td>
                <td><%= t.created_by_name || '-' %></td>
                <td><%= formatDateTime(t.created_at) %></td>
                <% if (user && user.role === 'user') { %>
                  <td>
                    <div class="actions">
                      <a class="btn ghost" href="/transactions?type=<%= type %>&edit=<%= t.id %>">Edit</a>
                      <form action="/transactions/<%= t.id %>/delete" method="post" onsubmit="return confirm('Hapus transaksi ini?')">
                        <input type="hidden" name="type" value="<%= type %>" />
                        <button class="btn danger" type="submit">Hapus</button>
                      </form>
                    </div>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
